# ---------------------------------------------------------------------------
# Supabase — required
# ---------------------------------------------------------------------------
# Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Project Settings -> API Keys -> anon / publishable
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API Keys -> service_role (secret).
# Server-only. Never expose this to the browser: it bypasses Row Level Security
# and is what the XP engine uses to call the game-logic functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site URL — required in production
# ---------------------------------------------------------------------------
# Used to build the redirect links in confirmation and password-reset emails.
# Locally this can stay as-is; on Vercel set it to your deployment URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Web Push — optional
# ---------------------------------------------------------------------------
# Generate a pair with:  npx web-push generate-vapid-keys
# Without these the app still writes in-app notifications; only the push
# channel is disabled, and the settings screen says so.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Scheduled jobs — optional
# ---------------------------------------------------------------------------
# Vercel sends this as a bearer token on cron requests. Set it to any random
# string; without it the cron endpoints refuse to run in production.
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI activity evaluation — optional
# ---------------------------------------------------------------------------
# With no key the deterministic rule-based classifier is used, which is a
# perfectly good default. Add a key to route evaluation through an LLM instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
